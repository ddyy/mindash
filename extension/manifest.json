{
  "manifest_version": 3,
  "name": "mindash new tab",
  "version": "1.2.0",
  "description": "Opens your self-hosted mindash dashboard in every new tab, painting the last-seen page instantly. Stores only your dashboard URL and that snapshot, both local to your browser.",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "mindash new tab settings",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://*.localhost/*",
    "http://127.0.0.1/*"
  ]
}
